rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Shared canvases are public-by-code: anyone who knows the 6-character
    // code can read the board, but documents can only be created once.
    match /shared_canvases/{code} {
      allow read: if true;
      allow create: if code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['nodes', 'edges', 'createdAt'])
        && request.resource.size < 1024 * 1024;
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
