rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Images referenced by shared canvases. Read is public; writes are
    // limited to reasonably sized images.
    match /canvas-images/{fileName} {
      allow read: if true;
      allow create: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
